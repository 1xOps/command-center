#!/usr/bin/env bash
# pre-push: this repository's fast local checks before anything reaches GitHub, as advice. It names what failed and lets
# the push go ahead: the person decides. Local first, so GitHub Actions minutes are kept for pull requests to main.
# Turned on per clone by `git config core.hooksPath .githooks`. `bash .githooks/pre-push --self-test` proves it.
set -uo pipefail
unset GIT_DIR GIT_WORK_TREE
fast=${GIT_STANDARD_FAST:-'cd cli && npm test --silent'}

run() { # runs the fast checks from the work tree root; prints advice on failure; always returns 0
  local out rc
  out=$(cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" && sh -c "$fast" 2>&1); rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$out" | tail -8
    echo "pre-push: advice - the fast checks failed (exit $rc); the push goes ahead. Run: $fast"
  else echo "pre-push: the fast checks pass ($fast)"; fi
  return 0
}

main_advice() { # reads git's pre-push lines on stdin; names a push to main as advice; always returns 0
  [ -t 0 ] && return 0
  while read -r _ _ remote_ref _; do
    [ "$remote_ref" = refs/heads/main ] && echo "pre-push: advice - main is protected: it takes a pull request from develop, tagged on main; the push goes ahead"
  done; return 0
}

if [ "${1:-}" = --self-test ]; then
  ok=0
  o=$(GIT_STANDARD_FAST='echo detail; exit 3' fast='echo detail; exit 3' run); rc=$?
  [ "$rc" = 0 ] && printf '%s' "$o" | grep -q 'exit 3' && printf '%s' "$o" | grep -q detail && ok=$((ok + 1)) || echo "  [FAIL] a failed check was not named, or the hook held the push back"
  o=$(fast=true run); rc=$?
  [ "$rc" = 0 ] && printf '%s' "$o" | grep -q 'pass' && ok=$((ok + 1)) || echo "  [FAIL] a passing check was not reported"
  [ -n "$fast" ] && case "$fast" in *@"FAST"@*) false ;; esac && ok=$((ok + 1)) || echo "  [FAIL] the fast check command is not set"
  o=$(printf 'refs/heads/develop 1 refs/heads/main 2\n' | main_advice); rc=$?
  [ "$rc" = 0 ] && printf '%s' "$o" | grep -q 'pull request from develop' && ok=$((ok + 1)) || echo "  [FAIL] a push to main was not named as advice"
  o=$(printf 'refs/heads/develop 1 refs/heads/develop 2\n' | main_advice)
  [ -z "$o" ] && ok=$((ok + 1)) || echo "  [FAIL] a push to develop was not silent"
  echo "pre-push self-test: $ok/5 cases as expected"; [ "$ok" = 5 ]; exit $?
fi

# Advice for everyone, never a blocker: the owner decides. Switch it off for this clone with
# `git config git-standard.advice off`; back on with `git config --unset git-standard.advice`.
[ "$(git config --get git-standard.advice 2>/dev/null)" = off ] && exit 0
main_advice; run; exit 0
