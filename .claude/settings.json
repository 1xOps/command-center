{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -b:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git switch -c:*)",
      "Bash(git tag:*)",
      "Bash(git worktree add:*)"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
